# Copier en .env puis adapter (ne jamais publier .env)
APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=veltron
DB_USER=root
DB_PASS=

# Clé secrète pour signer les jetons et codes OTP (64 caractères aléatoires minimum)
# Générer : php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me-with-a-long-random-string

# Envoi d'e-mails : "log" en local (écrit dans backend/verification.log et affiche une aide locale),
# "mail" pour utiliser mail()/SMTP configuré dans php.ini.
MAIL_MODE=log
MAIL_FROM=no-reply@veltron.app

# Propriétaire VELTRON (reçoit les alertes quand le moteur IA détecte une agence douteuse)
OWNER_NAME=Nathan Zoua
OWNER_EMAIL=zouanathan@veltron.app
OWNER_WHATSAPP=+237600000000
# Webhook WhatsApp optionnel (Cloud API / CallMeBot / Twilio) pour alerte instantanée
WHATSAPP_WEBHOOK_URL=

# Clé API Google Gemini optionnelle (active l'audit IA avancé gemini-3.8-flash en complément du moteur de sécurité intégré)
GEMINI_API_KEY=

# Commission automatique propriétaire VELTRON (50 bps = 0,50 % prélevés sur le montant totalisé de chaque voyage)
PLATFORM_COMMISSION_BPS=50
OWNER_PAYOUT_ACCOUNT="VELTRON OWNER - Nathan Zoua"

# Cartographie & GPS temps réel (none = suivi manuel/radar interactif autonome, google = Google Maps, mapbox = Mapbox)
MAPS_PROVIDER=none
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
